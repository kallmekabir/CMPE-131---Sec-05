generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PARTICIPANT
  ORGANIZER
}

enum EventStatus {
  ACTIVE
  CANCELLED
}

enum ParticipationStatus {
  JOINED
  WAITLISTED
  PASSED
  LEFT
}

model User {
  id               String   @id @default(uuid()) @map("user_id") @db.Uuid
  name             String
  universityEmail  String   @unique @map("university_email")
  displayName      String   @map("display_name")
  passwordHash     String?  @map("password_hash")
  role             UserRole @default(PARTICIPANT)
  major            String?
  interests        String[] @default([])
  skills           String[] @default([])
  emailVerified    Boolean  @default(false) @map("email_verified")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organizedEvents      Event[]
  participations       Participation[]
  refreshTokens        RefreshToken[]
  verificationTokens   EmailVerificationToken[]

  @@map("users")
}

model Event {
  id             String      @id @default(uuid()) @map("event_id") @db.Uuid
  organizerId    String      @map("organizer_id") @db.Uuid
  title          String
  description    String
  startsAt       DateTime    @map("starts_at")
  endsAt         DateTime?   @map("ends_at")
  location       String
  capacity       Int?
  waitlistEnabled Boolean    @default(false) @map("waitlist_enabled")
  imageUrl       String?     @map("image_url")
  tags           String[]    @default([])
  status         EventStatus @default(ACTIVE)
  deletedAt      DateTime?   @map("deleted_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organizer      User            @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  participations Participation[]

  @@index([startsAt])
  @@index([organizerId])
  @@index([status, deletedAt, startsAt])
  @@map("events")
}

model Participation {
  id         String              @id @default(uuid()) @map("participation_id") @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  eventId    String              @map("event_id") @db.Uuid
  status     ParticipationStatus
  queuedAt   DateTime?           @map("queued_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@index([eventId, status])
  @@index([eventId, status, queuedAt, id])
  @@map("participations")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}
