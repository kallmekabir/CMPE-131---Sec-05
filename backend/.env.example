NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://spartin:spartin_dev_only@localhost:5432/spartin
TEST_DATABASE_URL=postgresql://spartin:spartin_dev_only@localhost:5433/spartin_test
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-32chars-min
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
ALLOWED_EMAIL_DOMAINS=sjsu.edu
AUTH_PROVIDER=dev
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
PUBLIC_APP_URL=http://localhost:8081
LOG_LEVEL=debug
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=300

# Verification emails (required when AUTH_PROVIDER=local). Gmail: host smtp.gmail.com, port 587, user = the Gmail address,
# pass = a 16-character App Password (not the account password). Leave all blank in dev (AUTH_PROVIDER=dev auto-verifies).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# BETA ONLY: treat every approved-domain signup as verified (no email needed). Leave unset/false once email works.
BETA_SKIP_EMAIL_VERIFICATION=false
